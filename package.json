{
  "name": "github-action",
  "version": "46.3.11",
  "private": true,
  "description": "GitHub Action to run Renovate self-hosted.",
  "homepage": "https://github.com/renovatebot/github-action#readme",
  "bugs": {
    "url": "https://github.com/renovatebot/github-action/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "Jeroen de Bruijn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renovatebot/github-action.git"
  },
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "run-s clean compile",
    "clean": "rimraf dist/",
    "compile": "node tools/compile.js",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint",
    "lint:oxfmt": "oxfmt --check",
    "fix": "run-s fix:*",
    "fix:oxlint": "oxlint --fix",
    "fix:oxfmt": "oxfmt",
    "prepare": "husky",
    "release": "run-s clean build semantic-release",
    "semantic-release": "semantic-release",
    "start": "run-s build && node dist"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@containerbase/oxlint-plugin": "1.0.5",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.19.2",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "rimraf": "6.1.3",
    "semantic-release": "25.0.9",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.11.0",
    "pnpm": "^10.0.0"
  },
  "packageManager": "pnpm@10.34.7"
}
